# Example configuration for local development. Copy it to .env and edit it.
# Every value below is a placeholder. Never commit a real .env file.
#
# HoshiQueue does not read .env files by itself. Set these variables in the shell
# that starts the API and the worker (bash: export DATABASE_URL=...,
# PowerShell: $env:DATABASE_URL = "..."), or load the file with your own tooling.
#
# When a variable is not set, the built-in default is used. The default
# DATABASE_URL matches the development credentials in docker-compose.yml.

# PostgreSQL connection (SQLAlchemy URL, psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_DB_NAME

# Redis connection (an empty value also falls back to this default).
REDIS_URL=redis://localhost:6379/0
