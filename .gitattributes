# Keep line endings consistent across Windows, macOS and Linux.
# Text files are stored with LF in the repository and checked out with the
# platform's native line endings (CRLF on Windows).
* text=auto

# Scripts that must always run on Unix shells keep LF.
*.sh text eol=lf

# Never convert binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary
